# Copy to .env and fill in. Never commit the real .env.
#
# The hosted Supabase project for the team. Ask Sahas for the keys.
SUPABASE_URL=https://wlxzdvacbchiejgdmlcp.supabase.co

# Publishable (anon) key — safe for the frontend
SUPABASE_PUBLISHABLE_KEY=

# Service role (secret) key — BACKEND ONLY. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Direct Postgres connection string — backend / ingestion scripts only
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.wlxzdvacbchiejgdmlcp.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Local dev (optional): after `npm run db:start`, the Supabase CLI prints
# a local API URL / anon key / service role key. Drop those in here instead
# of the hosted values to develop fully offline.
# ---------------------------------------------------------------------------
