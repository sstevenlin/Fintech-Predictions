# --- GENERAL ---
PORT=8000
ENV=development

# --- DATABASE (Supabase) ---
DATABASE_URL=postgresql://user:password@localhost:5432/fintech_db
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- AUTH ---
AUTH_SECRET=generate_a_random_string_here

# --- KALSHI ---
# KALSHI_ENV=demo    # uncomment to target the Kalshi demo environment
KALSHI_API_KEY=your_kalshi_key_id_here
# KALSHI_API_SECRET: path to your RSA private key PEM file, or the PEM inline
# with literal \n for newlines. Only needed for Phase 2+ live order placement;
# leave blank for Phase 0/1 (observation and paper trading).
KALSHI_API_SECRET=/path/to/kalshi_private_key.pem

# --- POLYMARKET ---
POLYMARKET_API_KEY=your_polymarket_key_here

# --- SPORTS FEEDS ---
# ESPN public API — no key required, but set a descriptive User-Agent
ESPN_USER_AGENT=fintech-predictions/0.1

# Sportradar (Phase 3+, contract required)
# SPORTRADAR_API_KEY=your_sportradar_key_here

# --- PIPELINE TUNING ---
POLL_INTERVAL_MS=500          # ESPN poll cadence (ms)
MIN_EDGE_CENTS=5              # minimum gap to fire a trade
DRY_RUN=true                  # set false only for live Phase 2+

# --- OBSERVABILITY ---
SENTRY_DSN=https://example_public_key@sentry.io/example_project_id
