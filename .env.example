# --- GENERAL ---
PORT=8000
ENV=development # development, staging, or production

# --- DATABASE (Sahas) ---
# Replace with local Postgres URL for dev
DATABASE_URL=postgresql://user:password@localhost:5432/fintech_db

# --- AUTH (Sahas) ---
# Secret key for signing JWT tokens or sessions
AUTH_SECRET=generate_a_random_string_here

# --- MARKET DATA APIs (Princeden) ---
# Keys for Kalshi, Polymarket, or other data sources
KALSHI_API_KEY=your_kalshi_key_here
KALSHI_API_SECRET=your_kalshi_secret_here
POLYMARKET_API_KEY=your_polymarket_key_here

# --- OBSERVABILITY (Alan) ---
# Sentry DSN for error tracking
SENTRY_DSN=https://example_public_key@sentry.io/example_project_id