{
  "name": "fintech-predictions",
  "version": "0.1.0",
  "private": true,
  "description": "Sports latency-arbitrage on Kalshi prediction markets",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:studio": "supabase status -o env | grep STUDIO_URL",
    "observe": "ts-node observation/run.ts",
    "replay": "ts-node observation/replay.ts",
    "paper": "ts-node sports_arb/pipeline.ts --dry-run",
    "sim": "ts-node sports_arb/pipeline.ts --sim",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@polymarket/clob-client": "^5.8.1",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "ethers": "^5.8.0",
    "kalshi-typescript": "^3.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.39",
    "jest": "^30.3.0",
    "supabase": "^1.200.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
